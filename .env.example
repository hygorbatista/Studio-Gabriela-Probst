# Copie este arquivo para .env.local e preencha com os valores do Supabase
# (Dashboard > Project Settings > API Keys). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereço público do site (para a imagem de compartilhamento). Na Vercel é opcional.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Web Push do painel. As chaves privadas e o segredo do agendador são apenas do servidor.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@example.com
# NOTIFICATIONS_CRON_SECRET=
# SUPABASE_NOTIFICATION_SECRET_KEY=
